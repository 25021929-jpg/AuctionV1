<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.auction</groupId>
        <artifactId>AuctionV1</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>Auction-server</artifactId>

    <dependencies>

        <!-- Dùng DTO chung giữa client và server -->
        <dependency>
            <groupId>com.auction</groupId>
            <artifactId>Auction-shared</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- Chuyển object Java <-> JSON -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- Hibernate ORM -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>6.5.2.Final</version> <!-- Kiểm tra phiên bản mới nhất trên Maven Central -->
        </dependency>

        <!-- Kết nối MySQL -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version> </dependency>
        <!-- Sử dụng HikariCP để quản lý connection pool -->
        <dependency>
        <groupId>com.zaxxer</groupId>
        <artifactId>HikariCP</artifactId>
        <version>5.1.0</version>
    </dependency>
        <!-- Cài đặt lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.28</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>
    <build>
        <plugins>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.11.0</version> <!-- Hoặc phiên bản mới hơn -->
            <configuration>
                <annotationProcessorPaths>
                    <path>
                        <groupId>org.projectlombok</groupId>
                        <artifactId>lombok</artifactId>
                        <version>1.18.36</version> <!-- Khớp với version trong dependencies -->
                    </path>
                </annotationProcessorPaths>
                <source>25</source>
                <target>25</target>
            </configuration>
        </plugin>
        </plugins>

    </build>

</project>