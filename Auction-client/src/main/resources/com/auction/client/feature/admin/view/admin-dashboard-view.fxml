<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.feature.admin.controller.AdminDashboardController"
      spacing="14"
      style="-fx-background-color: #7FC8F7; -fx-font-family: 'Segoe UI', Arial;">

    <padding>
        <Insets top="22" right="22" bottom="22" left="22"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="← Back" onAction="#handleBack"
                style="-fx-background-color: rgba(255,255,255,0.65); -fx-background-radius: 10; -fx-text-fill: #0B2B4A; -fx-font-weight: bold;"/>
        <Button text="Auctions" onAction="#handleOpenAuctions"
                style="-fx-background-color: rgba(25,118,210,0.15); -fx-text-fill: #0D47A1; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 8 12 8 12;"/>
        <Button text="Clear log" onAction="#handleClearLog"
                style="-fx-background-color: rgba(25,118,210,0.15); -fx-text-fill: #0D47A1; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 8 12 8 12;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Đăng xuất" onAction="#handleLogout"
                style="-fx-background-color: rgba(0,0,0,0.08); -fx-text-fill: #0B2B4A; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 8 12 8 12;"/>
        <Label text="Admin"
               style="-fx-text-fill: rgba(11,43,74,0.85); -fx-font-weight: bold;"/>
    </HBox>

    <VBox spacing="12"
          style="-fx-background-color: rgba(255,255,255,0.92); -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 18, 0.15, 0, 6);">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>

        <Label text="Admin Dashboard"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0B2B4A;"/>
        <Label fx:id="lblSessionInfo" text="Session:"
               style="-fx-text-fill: rgba(11,43,74,0.85);"/>

        <Separator/>

        <Label text="Server Event Log (realtime, no polling)"
               style="-fx-font-weight: bold; -fx-text-fill: #0B2B4A;"/>
        <ListView fx:id="lvEventLog" prefHeight="420"
                  style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: rgba(11,43,74,0.12);"/>

        <Label text="Note: Màn hình admin hiện tại ưu tiên theo dõi realtime/event. API admin sẽ bổ sung khi server chốt."
               wrapText="true"
               style="-fx-text-fill: rgba(11,43,74,0.70); -fx-font-size: 12px;"/>

    </VBox>

</VBox>
