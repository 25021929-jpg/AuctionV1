<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.feature.auth.controller.ForgotPasswordController"
      stylesheets="@/com/auction/client/css/app-style.css"
      prefWidth="900" prefHeight="520"
      style="-fx-background-color: #020B18;">

    <!-- LEFT -->
    <VBox prefWidth="360" prefHeight="520" alignment="CENTER" spacing="18"
          style="-fx-background-color: #051529;
                 -fx-border-color: transparent rgba(21,101,255,0.2) transparent transparent;
                 -fx-border-width: 0 1 0 0; -fx-padding: 40px;">
        <ImageView fitWidth="100" fitHeight="100" preserveRatio="true"
                   style="-fx-effect: dropshadow(gaussian, rgba(0,180,255,0.5), 20, 0, 0, 0);">
            <image><Image url="@/com/auction/client/css/logo.png"/></image>
        </ImageView>
        <Label text="TVP AUCTION" styleClass="title" style="-fx-font-size: 22px;"/>
        <Label text="Khôi phục tài khoản" styleClass="subtitle"/>
        <Pane styleClass="divider" prefWidth="180" style="-fx-max-width:180;"/>
        <VBox spacing="12">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="①" style="-fx-text-fill:#1565FF;-fx-font-size:16px;"/>
                <Label text="Nhập email đã đăng ký" styleClass="subtitle" style="-fx-text-fill:#B8C8DC;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="②" style="-fx-text-fill:#2A4A6A;-fx-font-size:16px;"/>
                <Label text="Nhận mã OTP qua email" styleClass="subtitle"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="③" style="-fx-text-fill:#2A4A6A;-fx-font-size:16px;"/>
                <Label text="Đặt lại mật khẩu mới" styleClass="subtitle"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- RIGHT — StackPane chứa 4 bước -->
    <StackPane fx:id="formBox" prefWidth="540" prefHeight="520"
               style="-fx-background-color:#020B18; -fx-padding: 40px 60px;">

        <!-- Bước 1: Email -->
        <VBox fx:id="stepEmail" spacing="16" alignment="CENTER" maxWidth="360">
            <Label text="QUÊN MẬT KHẨU" style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:#4FC3F7;-fx-letter-spacing:3px;"/>
            <Label text="Nhập email để nhận mã xác nhận" styleClass="subtitle"/>
            <Label fx:id="emailError" styleClass="alert-error" wrapText="true" maxWidth="360" visible="false" managed="false"/>
            <VBox spacing="6">
                <Label text="ĐỊA CHỈ EMAIL" styleClass="field-label"/>
                <TextField fx:id="emailField" styleClass="text-field" prefWidth="360"/>
            </VBox>
            <Button fx:id="sendOtpBtn" text="GỬI MÃ XÁC NHẬN" styleClass="btn-primary"
                    prefWidth="360" onAction="#handleSendOtp" defaultButton="true"/>
            <HBox alignment="CENTER" spacing="6">
                <Label text="Nhớ mật khẩu rồi?" styleClass="subtitle"/>
                <Button text="Đăng nhập" styleClass="btn-link" onAction="#handleNavigateLogin"/>
            </HBox>
        </VBox>

        <!-- Bước 2: OTP -->
        <VBox fx:id="stepOtp" spacing="16" alignment="CENTER" maxWidth="360" visible="false" managed="false">
            <Label text="NHẬP MÃ OTP" style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:#4FC3F7;-fx-letter-spacing:3px;"/>
            <Label fx:id="otpHint" text="Mã đã gửi đến email của bạn" styleClass="subtitle"/>
            <Label fx:id="otpError" styleClass="alert-error" wrapText="true" maxWidth="360" visible="false" managed="false"/>
            <VBox spacing="6">
                <Label text="MÃ XÁC NHẬN (6 SỐ)" styleClass="field-label"/>
                <TextField fx:id="otpField" styleClass="text-field" prefWidth="360"
                           style="-fx-font-size:22px;-fx-letter-spacing:8px;-fx-alignment:CENTER;"/>
            </VBox>
            <HBox alignment="CENTER" spacing="6">
                <Label text="Gửi lại sau" styleClass="subtitle"/>
                <Label fx:id="countdownLabel" text="60s" style="-fx-text-fill:#4FC3F7;-fx-font-weight:bold;-fx-font-size:13px;"/>
                <Button fx:id="resendBtn" text="Gửi lại" styleClass="btn-link"
                        visible="false" managed="false" onAction="#handleResendOtp"/>
            </HBox>
            <Button text="XÁC NHẬN" styleClass="btn-primary" prefWidth="360"
                    onAction="#handleVerifyOtp" defaultButton="true"/>
            <Button text="← Quay lại" styleClass="btn-link" onAction="#handleBackToEmail"
                    style="-fx-text-fill:#4A6880;"/>
        </VBox>

        <!-- Bước 3: Mật khẩu mới -->
        <VBox fx:id="stepReset" spacing="16" alignment="CENTER" maxWidth="360" visible="false" managed="false">
            <Label text="MẬT KHẨU MỚI" style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:#4FC3F7;-fx-letter-spacing:3px;"/>
            <Label text="Đặt mật khẩu mới cho tài khoản" styleClass="subtitle"/>
            <Label fx:id="resetError" styleClass="alert-error" wrapText="true" maxWidth="360" visible="false" managed="false"/>
            <VBox spacing="6">
                <Label text="MẬT KHẨU MỚI" styleClass="field-label"/>
                <PasswordField fx:id="newPasswordField" styleClass="password-field" prefWidth="360"/>
            </VBox>
            <VBox spacing="6">
                <Label text="XÁC NHẬN MẬT KHẨU" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" styleClass="password-field" prefWidth="360"/>
            </VBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="ĐỘ MẠNH:" styleClass="field-label" style="-fx-font-size:11px;"/>
                <Label fx:id="strengthLabel" text="—" style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#4A6880;"/>
            </HBox>
            <ProgressBar fx:id="strengthBar" prefWidth="360" prefHeight="4" progress="0"/>
            <Button text="ĐẶT LẠI MẬT KHẨU" styleClass="btn-primary" prefWidth="360"
                    onAction="#handleResetPassword" defaultButton="true"/>
        </VBox>

        <!-- Bước 4: Thành công -->
        <VBox fx:id="stepSuccess" spacing="20" alignment="CENTER" maxWidth="360" visible="false" managed="false">
            <Label text="✓" style="-fx-font-size:60px;-fx-text-fill:#00E5A0;"/>
            <Label text="THÀNH CÔNG!" style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#00E5A0;-fx-letter-spacing:3px;"/>
            <Label text="Mật khẩu đã được đặt lại thành công." styleClass="subtitle"/>
            <Button text="VỀ TRANG ĐĂNG NHẬP" styleClass="btn-primary"
                    prefWidth="280" onAction="#handleNavigateLogin"/>
        </VBox>

    </StackPane>
</HBox>
