<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.feature.auction.controller.AuctionListController"
            prefWidth="1050" prefHeight="700"
            styleClass="app-background"
            stylesheets="@/com/auction/client/css/app-style.css">

    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="← Trang chủ" onAction="#handleBack" styleClass="btn-ghost"/>
            <VBox spacing="3">
                <Label text="Danh sách phiên đấu giá" styleClass="page-title"/>
                <Label text="Chọn một phiên để xem chi tiết và vào phòng đấu giá realtime." styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="loadingIndicator" maxWidth="22" maxHeight="22" visible="false"/>
            <Button fx:id="btnRefresh" text="Tải lại" onAction="#handleRefresh" styleClass="btn-primary"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12" styleClass="panel">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Sản phẩm đang được đấu giá" styleClass="section-title"/>
                    <Label text="Double-click vào một dòng để mở màn chi tiết." styleClass="section-subtitle"/>
                </VBox>
            </HBox>

            <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS" prefHeight="540">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colName" text="Sản phẩm" prefWidth="360"/>
                    <TableColumn fx:id="colPrice" text="Giá hiện tại" prefWidth="170"/>
                    <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="150"/>
                </columns>
            </TableView>

            <Label text="Mẹo: đặt giá chỉ nên thực hiện trong màn phòng đấu giá để dữ liệu realtime rõ ràng hơn." wrapText="true" styleClass="muted-label"/>
        </VBox>
    </center>

</BorderPane>
