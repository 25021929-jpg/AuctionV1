<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.feature.bidding.controller.LiveBiddingController"
      spacing="14"
      style="-fx-background-color: #7FC8F7; -fx-font-family: 'Segoe UI', Arial;">

    <padding>
        <Insets top="22" right="22" bottom="22" left="22"/>
    </padding>

    <!-- Top bar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="← Back" onAction="#handleBack"
                style="-fx-background-color: rgba(255,255,255,0.65); -fx-background-radius: 10; -fx-text-fill: #0B2B4A; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Realtime"
               style="-fx-text-fill: rgba(11,43,74,0.85); -fx-font-weight: bold;"/>
    </HBox>

    <!-- Card -->
    <VBox spacing="12"
          style="-fx-background-color: rgba(255,255,255,0.92); -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 18, 0.15, 0, 6);">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>

        <Label text="Đấu giá trực tiếp"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0B2B4A;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Giá hiện tại:"
                   style="-fx-text-fill: rgba(11,43,74,0.85); -fx-font-weight: bold;"/>
            <Label fx:id="lblCurrentPrice"
                   style="-fx-text-fill: #0B2B4A; -fx-font-size: 14px;"/>
        </HBox>

        <Separator/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="bidAmountField" promptText="Nhập giá bạn muốn đặt"
                       style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(11,43,74,0.18); -fx-padding: 8 10 8 10;"/>
            <ProgressIndicator fx:id="placingIndicator" maxWidth="18" maxHeight="18" visible="false"/>
            <Button fx:id="btnPlaceBid" text="Đặt giá" onAction="#handlePlaceBid"
                    style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-padding: 8 14 8 14;"/>
        </HBox>

        <LineChart fx:id="priceChart" prefHeight="280"
                   style="-fx-background-color: transparent;">
            <xAxis>
                <CategoryAxis label="Time"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Price"/>
            </yAxis>
        </LineChart>

        <Label text="Gợi ý: Nếu server chưa push event, chart sẽ chỉ cập nhật khi đặt giá thành công."
               wrapText="true"
               style="-fx-text-fill: rgba(11,43,74,0.75); -fx-font-size: 12px;"/>

    </VBox>

</VBox>
