<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.feature.bidding.controller.LiveBiddingController"
      prefWidth="1000" prefHeight="720" spacing="18"
      styleClass="app-background"
      stylesheets="@/com/auction/client/css/app-style.css">

    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="← Quay lại" onAction="#handleBack" styleClass="btn-ghost"/>
        <VBox spacing="3">
            <Label text="Phòng đấu giá trực tiếp" styleClass="page-title"/>
            <Label text="Theo dõi giá realtime và đặt giá cao hơn giá hiện tại." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Realtime" styleClass="field-label"/>
    </HBox>

    <HBox spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="panel-soft">
            <Label text="Giá hiện tại" styleClass="stat-label"/>
            <Label fx:id="lblCurrentPrice" text="-" styleClass="price-value"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="panel-soft">
            <Label text="Quy tắc" styleClass="stat-label"/>
            <Label text="Giá đặt phải lớn hơn giá hiện tại" styleClass="info-value"/>
        </VBox>
    </HBox>

    <VBox spacing="14" VBox.vgrow="ALWAYS" styleClass="panel">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="bidAmountField" promptText="Nhập số tiền muốn đặt" HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="placingIndicator" maxWidth="22" maxHeight="22" visible="false"/>
            <Button fx:id="btnPlaceBid" text="Đặt giá" onAction="#handlePlaceBid" styleClass="btn-primary"/>
        </HBox>

        <LineChart fx:id="priceChart" VBox.vgrow="ALWAYS" prefHeight="430" animated="false" createSymbols="true">
            <xAxis>
                <CategoryAxis label="Thời gian"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Giá"/>
            </yAxis>
        </LineChart>

        <Label text="Gợi ý: nếu server chưa push event, biểu đồ sẽ cập nhật sau khi đặt giá thành công hoặc khi tải lại dữ liệu." wrapText="true" styleClass="muted-label"/>
    </VBox>

</VBox>
