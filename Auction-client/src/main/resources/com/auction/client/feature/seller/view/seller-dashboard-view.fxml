<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.feature.seller.controller.SellerDashboardController"
            prefWidth="1100" prefHeight="720"
            styleClass="app-background"
            stylesheets="@/com/auction/client/css/app-style.css">

    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="← Trang chủ" onAction="#handleBack" styleClass="btn-ghost"/>
            <VBox spacing="3">
                <Label text="Quản lý sản phẩm" styleClass="page-title"/>
                <Label text="Tạo, sửa, xóa sản phẩm đấu giá dành cho Seller." styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="loadingIndicator" maxWidth="22" maxHeight="22" visible="false"/>
            <Button fx:id="btnRefresh" text="Tải lại" onAction="#handleRefresh" styleClass="btn-ghost"/>
            <Button fx:id="btnAdd" text="+ Thêm" onAction="#handleAdd" styleClass="btn-primary"/>
            <Button fx:id="btnEdit" text="Sửa" onAction="#handleEdit" styleClass="btn-secondary"/>
            <Button fx:id="btnDelete" text="Xóa" onAction="#handleDelete" styleClass="btn-danger"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12" styleClass="panel">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Danh sách sản phẩm của bạn" styleClass="section-title"/>
                    <Label text="Chọn một dòng rồi dùng Sửa/Xóa. Nếu server chưa hỗ trợ SELLER_*, các nút sẽ báo lỗi rõ ràng." styleClass="section-subtitle"/>
                </VBox>
            </HBox>

            <TableView fx:id="tblItems" VBox.vgrow="ALWAYS" prefHeight="540">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colName" text="Tên sản phẩm" prefWidth="260"/>
                    <TableColumn fx:id="colStartPrice" text="Giá khởi điểm" prefWidth="150"/>
                    <TableColumn fx:id="colCurrentPrice" text="Giá hiện tại" prefWidth="150"/>
                    <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="130"/>
                    <TableColumn fx:id="colEndTime" text="Kết thúc" prefWidth="190"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
