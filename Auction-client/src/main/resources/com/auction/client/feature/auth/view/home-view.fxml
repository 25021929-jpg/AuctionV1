<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.feature.auth.controller.HomeController"
            prefWidth="1100" prefHeight="720"
            styleClass="app-background"
            stylesheets="@/com/auction/client/css/app-style.css">

    <left>
        <VBox prefWidth="270" spacing="18" styleClass="sidebar">
            <VBox spacing="10" alignment="CENTER_LEFT">
                <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                    <image><Image url="@/com/auction/client/css/logo.png"/></image>
                </ImageView>
                <VBox spacing="2">
                    <Label text="TVP AUCTION" styleClass="sidebar-brand-title"/>
                    <Label text="Đấu giá trực tuyến" styleClass="sidebar-brand-subtitle"/>
                </VBox>
            </VBox>

            <Pane styleClass="divider"/>

            <VBox spacing="8">
                <Button text="Danh sách phiên đấu giá" onAction="#handleOpenAuctionList"
                        maxWidth="1.7976931348623157E308" styleClass="side-nav-button"/>
                <Button text="Ví tài khoản / Nạp tiền" onAction="#handleOpenWallet"
                        maxWidth="1.7976931348623157E308" styleClass="side-nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="10" styleClass="sidebar-user-card">
                <Label fx:id="lblWelcome" text="Chọn chức năng bạn muốn sử dụng" styleClass="info-value" wrapText="true"/>
                <Label fx:id="lblBalance" text="Số dư: 0" styleClass="price-value" wrapText="true"/>
            </VBox>

            <Button text="Đăng xuất" onAction="#handleLogout"
                    maxWidth="1.7976931348623157E308" styleClass="logout-button"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" styleClass="content-area">
            <VBox spacing="4">
                <Label text="Trang chủ" styleClass="page-title"/>
                <Label text="Chọn chức năng phù hợp với vai trò tài khoản của bạn." styleClass="page-subtitle"/>
            </VBox>

            <HBox spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="panel-soft">
                    <Label text="Đấu giá realtime" styleClass="stat-label"/>
                    <Label text="Theo dõi phiên và đặt giá trực tiếp" styleClass="info-value" wrapText="true"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="panel-soft">
                    <Label text="Ví tài khoản" styleClass="stat-label"/>
                    <Label text="Nạp tiền, xem số dư và lịch sử giao dịch" styleClass="info-value" wrapText="true"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" styleClass="panel-soft">
                    <Label text="Thông báo kết thúc" styleClass="stat-label"/>
                    <Label text="Seller và bidder nhận kết quả khi phiên kết thúc" styleClass="info-value" wrapText="true"/>
                </VBox>
            </HBox>

            <VBox spacing="14" styleClass="panel" VBox.vgrow="ALWAYS">
                <VBox spacing="3">
                    <Label text="Thao tác nhanh" styleClass="section-title"/>
                    <Label text="Các nút bên dưới đã được lọc theo role; seller/admin mới thấy chức năng quản lý phù hợp." styleClass="section-subtitle" wrapText="true"/>
                </VBox>

                <GridPane hgap="14" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    </columnConstraints>

                    <Button text="Danh sách phiên đấu giá" onAction="#handleOpenAuctionList"
                            maxWidth="1.7976931348623157E308" styleClass="btn-primary"
                            GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Button text="Ví tài khoản / Nạp tiền" onAction="#handleOpenWallet"
                            maxWidth="1.7976931348623157E308" styleClass="btn-secondary"
                            GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Button fx:id="btnSeller" text="Seller Dashboard" onAction="#handleOpenSeller"
                            maxWidth="1.7976931348623157E308" styleClass="btn-secondary"
                            GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Button fx:id="btnAdmin" text="Admin Dashboard" onAction="#handleOpenAdmin"
                            maxWidth="1.7976931348623157E308" styleClass="btn-secondary"
                            GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                </GridPane>

                <Region VBox.vgrow="ALWAYS"/>

                <Label text="Ghi chú: seller không được tự đấu giá sản phẩm của mình; bidder phải nạp tiền trước nếu số dư không đủ." styleClass="muted-label" wrapText="true"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
