<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760" prefWidth="1200" style="-fx-background-color: #020B18;" stylesheets="@/com/auction/client/css/app-style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.auth.controller.HomeController">

    <!-- ═══ TOP NAV ═══ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60" spacing="0" style="-fx-padding: 0 24px;" styleClass="nav-bar">

            <!-- Logo + Name -->
            <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                    <image><Image url="@/com/auction/client/css/logo.png" /></image>
                </ImageView>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;                               -fx-text-fill: #E8EEF7;                               -fx-effect: dropshadow(gaussian, rgba(0,180,255,0.5), 8, 0, 0, 0);" text="TVP AUCTION" />
            </HBox>

            <!-- Nav tabs -->
            <HBox spacing="4">
                <Button onAction="#handleNavDashboard" styleClass="nav-item" text="Tổng quan" />
                <Button onAction="#handleNavAuctions" styleClass="nav-item" text="Đấu giá" />
                <Button onAction="#handleNavAssets" styleClass="nav-item" text="Tài sản" />
                <Button onAction="#handleNavHistory" styleClass="nav-item" text="Lịch sử" />
            </HBox>

            <!-- User + Logout -->
            <HBox alignment="CENTER_RIGHT" spacing="12" HBox.hgrow="ALWAYS">
                <Label fx:id="usernameLabel" style="-fx-text-fill: #B8C8DC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Người dùng" />
                <Button fx:id="logoutBtn" onAction="#handleLogout" style="-fx-font-size: 12px; -fx-pref-height: 34px; -fx-padding: 6 16;" styleClass="btn-secondary" text="Đăng xuất" />
            </HBox>
        </HBox>
    </top>

    <!-- ═══ MAIN ═══ -->
    <center>
        <HBox>
            <!-- Sidebar -->
            <VBox prefWidth="220" spacing="4" style="-fx-background-color: #051529;                          -fx-border-color: transparent rgba(21,101,255,0.2) transparent transparent;                          -fx-border-width: 0 1 0 0;                          -fx-padding: 20 10;">

                <Label style="-fx-text-fill: #2A4A6A; -fx-font-size: 10px;                                            -fx-font-weight: bold; -fx-padding: 0 10 10 10;" text="MENU" />
                <Button onAction="#handleNavDashboard" prefWidth="200" styleClass="nav-item-active" text="📊  Tổng quan" />
                <Button onAction="#handleNavAuctions" prefWidth="200" styleClass="nav-item" text="🔨  Phiên đấu giá" />
                <Button onAction="#handleNavMyAssets" prefWidth="200" styleClass="nav-item" text="📦  Tài sản của tôi" />
                <Button onAction="#handleNavWallet" prefWidth="200" styleClass="nav-item" text="💰  Ví của tôi" />
                <Button onAction="#handleNavHistory" prefWidth="200" styleClass="nav-item" text="📋  Lịch sử" />
                <Pane VBox.vgrow="ALWAYS" />
                <Pane styleClass="divider" />
                <Button onAction="#handleNavSettings" prefWidth="200" styleClass="nav-item" text="⚙️  Cài đặt" />
            </VBox>

            <!-- Content -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;                                -fx-border-color: transparent;" HBox.hgrow="ALWAYS">
                <VBox spacing="20" style="-fx-padding: 24px 28px;">

                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;                                           -fx-text-fill: #4FC3F7; -fx-letter-spacing: 2px;" text="TỔNG QUAN" />
                            <Label fx:id="welcomeLabel" styleClass="subtitle" text="Chào mừng trở lại!" />
                        </VBox>
                        <Label fx:id="currentTimeLabel" style="-fx-font-size: 14px; -fx-text-fill: #4FC3F7; -fx-font-weight: bold;" text="--:--" />
                    </HBox>

                    <!-- Stat Cards -->
                    <HBox spacing="14">
                        <VBox spacing="8" style="-fx-padding: 18px 20px;" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label styleClass="stat-label" text="PHIÊN ĐANG MỞ" />
                            <Label fx:id="activeAuctionsCount" styleClass="stat-value" text="24" />
                            <Label style="-fx-text-fill: #00E5A0; -fx-font-size: 12px;" text="▲ 3 mới hôm nay" />
                        </VBox>
                        <VBox spacing="8" style="-fx-padding: 18px 20px;" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label styleClass="stat-label" text="GIÁ THẦU CỦA TÔI" />
                            <Label fx:id="myBidsCount" styleClass="stat-value" text="7" />
                            <Label style="-fx-text-fill: #4FC3F7; -fx-font-size: 12px;" text="2 đang dẫn đầu" />
                        </VBox>
                        <VBox spacing="8" style="-fx-padding: 18px 20px;" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label styleClass="stat-label" text="ĐÃ THẮNG" />
                            <Label fx:id="wonCount" styleClass="stat-value" text="3" />
                            <Label style="-fx-text-fill: #C8A84B; -fx-font-size: 12px;" text="Tổng: 45.000.000đ" />
                        </VBox>
                        <VBox spacing="8" style="-fx-padding: 18px 20px;" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label styleClass="stat-label" text="SỐ DƯ VÍ" />
                            <Label fx:id="walletBalance" style="-fx-font-size: 26px; -fx-font-weight: bold;                                           -fx-text-fill: #00E5A0;" text="12.5M" />
                            <Label styleClass="stat-label" text="VNĐ khả dụng" />
                        </VBox>
                    </HBox>

                    <!-- Auction Table -->
                    <VBox spacing="0" style="-fx-padding: 0;" styleClass="card">
                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 16px 20px;">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;                                           -fx-text-fill: #E8EEF7;" text="PHIÊN ĐẤU GIÁ ĐANG MỞ" HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleViewAllAuctions" style="-fx-font-size: 12px;" styleClass="btn-link" text="Xem tất cả" />
                        </HBox>
                        <Pane styleClass="divider" />
                        <TableView fx:id="auctionTable" prefHeight="260" style="-fx-border-width: 0; -fx-background-insets: 0; -fx-padding: 0;" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="100" text="MÃ PHIÊN" />
                                <TableColumn fx:id="colName" prefWidth="280" text="TÀI SẢN" />
                                <TableColumn fx:id="colCurrentPrice" prefWidth="160" text="GIÁ HIỆN TẠI" />
                                <TableColumn fx:id="colEndTime" prefWidth="160" text="KẾT THÚC" />
                                <TableColumn fx:id="colStatus" prefWidth="217.33333333333337" text="TRẠNG THÁI" />
                            </columns>
                            <placeholder>
                                <Label styleClass="subtitle" text="Không có phiên nào đang mở" />
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- Quick Actions -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button onAction="#handleJoinAuction" style="-fx-pref-height: 40px; -fx-font-size: 13px; -fx-padding: 0 24px;" styleClass="btn-primary" text="🔨 Tham gia đấu giá" />
                        <Button onAction="#handleRegisterAsset" style="-fx-pref-height: 40px;" styleClass="btn-secondary" text="📦 Đăng tài sản" />
                        <Button onAction="#handleTopUpWallet" style="-fx-pref-height: 40px;" styleClass="btn-secondary" text="💰 Nạp tiền" />
                    </HBox>

                </VBox>
            </ScrollPane>
        </HBox>
    </center>

    <!-- ═══ STATUS BAR ═══ -->
    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="28" spacing="16" style="-fx-background-color: #020B18;                      -fx-border-color: rgba(21,101,255,0.15) transparent transparent transparent;                      -fx-border-width: 1 0 0 0; -fx-padding: 0 20px;">
            <Label style="-fx-text-fill: #00E5A0; -fx-font-size: 10px; -fx-font-weight: bold;" text="● TRỰC TUYẾN" />
            <Label style="-fx-text-fill: #1A2A3A;" text="|" />
            <Label style="-fx-text-fill: #2A3A4A; -fx-font-size: 10px;" text="TVP AUCTION v1.0" />
        </HBox>
    </bottom>

</BorderPane>
