<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.feature.auth.controller.HomeController"
           style="-fx-background-color: #7FC8F7;">

    <!-- Card container -->
    <VBox maxWidth="520"
          spacing="14"
          style="-fx-background-color: rgba(255,255,255,0.92);
                 -fx-background-radius: 18;
                 -fx-border-radius: 18;
                 -fx-border-color: rgba(255,255,255,0.55);
                 -fx-border-width: 1;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 18, 0.15, 0, 6);">
        <padding>
            <Insets top="22" right="22" bottom="22" left="22"/>
        </padding>

        <!-- Header -->
        <VBox spacing="4">
            <Label text="Home"
                   style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #0B2545;"/>
            <Label fx:id="lblWelcome" text="Chọn chức năng bạn muốn sử dụng"
                   style="-fx-font-size: 13px; -fx-text-fill: rgba(11,37,69,0.75);"/>
        </VBox>

        <Separator opacity="0.35"/>

        <!-- Main actions -->
        <VBox spacing="10">
            <Button text="Danh sách phiên đấu giá"
                    onAction="#handleOpenAuctionList"
                    maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: #1F7AE0;
                           -fx-text-fill: white;
                           -fx-font-weight: 700;
                           -fx-background-radius: 12;
                           -fx-padding: 10 14;"/>

            <Button fx:id="btnSeller" text="Seller Dashboard"
                    onAction="#handleOpenSeller"
                    maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: rgba(31,122,224,0.12);
                           -fx-text-fill: #0B2545;
                           -fx-font-weight: 700;
                           -fx-background-radius: 12;
                           -fx-padding: 10 14;
                           -fx-border-color: rgba(31,122,224,0.25);
                           -fx-border-radius: 12;
                           -fx-border-width: 1;"/>

            <Button fx:id="btnAdmin" text="Admin Dashboard"
                    onAction="#handleOpenAdmin"
                    maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: rgba(31,122,224,0.12);
                           -fx-text-fill: #0B2545;
                           -fx-font-weight: 700;
                           -fx-background-radius: 12;
                           -fx-padding: 10 14;
                           -fx-border-color: rgba(31,122,224,0.25);
                           -fx-border-radius: 12;
                           -fx-border-width: 1;"/>
        </VBox>

        <Region prefHeight="6"/>

        <Separator opacity="0.35"/>

        <!-- Footer -->
        <HBox spacing="10">
            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Đăng xuất"
                    onAction="#handleLogout"
                    style="-fx-background-color: rgba(0,0,0,0.08);
                           -fx-text-fill: #0B2545;
                           -fx-font-weight: 700;
                           -fx-background-radius: 10;
                           -fx-padding: 8 12;"/>
        </HBox>

    </VBox>
</StackPane>