<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.feature.auth.controller.RegisterController"
      stylesheets="@/com/auction/client/css/app-style.css"
      prefWidth="940" prefHeight="660"
      styleClass="app-background">

    <!-- LEFT — Branding -->
    <VBox prefWidth="320" prefHeight="660" alignment="CENTER" spacing="20"
          style="-fx-background-color: #051529;
                 -fx-border-color: transparent rgba(21,101,255,0.2) transparent transparent;
                 -fx-border-width: 0 1 0 0;
                 -fx-padding: 40px 30px;">

        <ImageView fitWidth="100" fitHeight="100" preserveRatio="true"
                   style="-fx-effect: dropshadow(gaussian, rgba(0,180,255,0.5), 20, 0, 0, 0);">
            <image><Image url="@/com/auction/client/css/logo.png"/></image>
        </ImageView>

        <Label text="TVP AUCTION" styleClass="title" style="-fx-font-size: 22px;"/>
        <Label text="Tạo tài khoản mới" styleClass="subtitle"/>

        <Pane styleClass="divider" prefWidth="180" style="-fx-max-width: 180;"/>

        <VBox spacing="12" style="-fx-padding: 8 0 0 0;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="①" style="-fx-text-fill: #1565FF; -fx-font-size: 16px;"/>
                <Label text="Nhập thông tin cá nhân" styleClass="subtitle"
                       style="-fx-text-fill: #B8C8DC;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="②" style="-fx-text-fill: #2A4A6A; -fx-font-size: 16px;"/>
                <Label text="Đặt mật khẩu bảo mật" styleClass="subtitle"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="③" style="-fx-text-fill: #2A4A6A; -fx-font-size: 16px;"/>
                <Label text="Xác nhận và hoàn tất" styleClass="subtitle"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- RIGHT — Form -->
    <VBox prefWidth="620" prefHeight="660" alignment="CENTER" spacing="0"
          style="-fx-background-color: #020B18; -fx-padding: 40px 50px;">

        <VBox spacing="4" alignment="CENTER" style="-fx-padding: 0 0 28px 0;">
            <Label text="ĐĂNG KÝ TÀI KHOẢN"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;
                          -fx-text-fill: #4FC3F7; -fx-letter-spacing: 2px;"/>
            <Label text="Điền đầy đủ thông tin bên dưới" styleClass="subtitle"/>
        </VBox>

        <!-- Message -->
        <Label fx:id="messageLabel" wrapText="true" maxWidth="480"
               visible="false" managed="false" style="-fx-padding: 8 14; -fx-margin: 0 0 12 0;"/>

        <VBox spacing="14" maxWidth="480">
            <!-- Row 1 -->
            <HBox spacing="14">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="HỌ VÀ TÊN" styleClass="field-label"/>
                    <TextField fx:id="fullNameField" promptText="Nguyễn Văn A"
                               styleClass="text-field"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="TÊN ĐĂNG NHẬP" styleClass="field-label"/>
                    <TextField fx:id="usernameField" promptText="username"
                               styleClass="text-field"/>
                </VBox>
            </HBox>

            <!-- Email -->
            <VBox spacing="5">
                <Label text="EMAIL" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="example@email.com"
                           styleClass="text-field" prefWidth="480"/>
            </VBox>

            <!-- Row 2 -->
            <HBox spacing="14">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="SỐ ĐIỆN THOẠI" styleClass="field-label"/>
                    <TextField fx:id="phoneField" promptText="0901 234 567"
                               styleClass="text-field"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="NGÀY SINH" styleClass="field-label"/>
                    <TextField fx:id="dobField" promptText="DD/MM/YYYY"
                               styleClass="text-field"/>
                </VBox>
            </HBox>

            <!-- Row 3 -->
            <HBox spacing="14">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="MẬT KHẨU" styleClass="field-label"/>
                    <PasswordField fx:id="passwordField" promptText="Tối thiểu 8 ký tự"
                                   styleClass="password-field"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="XÁC NHẬN MẬT KHẨU" styleClass="field-label"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu"
                                   styleClass="password-field"/>
                </VBox>
            </HBox>

            <!-- Error label -->
            <Label fx:id="errorLabel" styleClass="alert-error" wrapText="true"
                   maxWidth="480" visible="false" managed="false"/>

            <Button fx:id="registerBtn" text="TẠO TÀI KHOẢN" styleClass="btn-primary"
                    prefWidth="480" onAction="#handleRegister" defaultButton="true"
                    style="-fx-margin: 4 0 0 0;"/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Đã có tài khoản?" styleClass="subtitle"/>
                <Button text="Đăng nhập" styleClass="btn-link"
                        onAction="#handleNavigateLogin"/>
            </HBox>
        </VBox>
    </VBox>
</HBox>
