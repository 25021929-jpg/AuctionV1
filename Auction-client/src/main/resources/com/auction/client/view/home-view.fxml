<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.auction.client.controller.HomeController"
           stylesheets="@../css/app-style.css"
           styleClass="auth-container">

    <VBox styleClass="auth-card">

        <Label text="Trang chủ" styleClass="title-label"/>
        <Label text="Chào mừng bạn đến với hệ thống đấu giá trực tuyến" styleClass="subtitle-label"/>

        <Button text="Đăng xuất"
                onAction="#handleLogout"
                styleClass="home-button"/>

    </VBox>
</StackPane>