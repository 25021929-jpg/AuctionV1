<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.auth.controller.RegisterController"
      alignment="CENTER"
      spacing="12"
      style="-fx-background-color: linear-gradient(to bottom, #1a1a2e, #16213e, #0f3460);">

    <padding>
        <Insets top="50" right="60" bottom="50" left="60"/>
    </padding>

    <!-- Logo-->
    <ImageView fitWidth="100" fitHeight="100" preserveRatio="true" opacity="0.7">
        <image>
            <Image url="@../../images/logo.png"/>
        </image>
    </ImageView>

    <!-- Tiêu đề app -->
    <Label text="TVP AUCTION"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e2b96f;
                  -fx-letter-spacing: 3px;"/>

    <!-- Tiêu đề màn hình -->
    <Label text="ĐĂNG KÝ"
           style="-fx-font-size: 13px; -fx-text-fill: #aaaaaa;
                  -fx-letter-spacing: 2px;"/>

    <!-- Username -->
    <TextField fx:id="usernameField" promptText="Tên đăng nhập"
               maxWidth="320"
               style="-fx-background-color: rgba(255,255,255,0.08);
                      -fx-text-fill: white;
                      -fx-prompt-text-fill: #888888;
                      -fx-font-size: 14px;
                      -fx-padding: 12px 16px;
                      -fx-border-color: #e2b96f;
                      -fx-border-width: 0 0 1 0;
                      -fx-background-radius: 6;"/>

    <!-- Email -->
    <TextField fx:id="emailField" promptText="Email"
               maxWidth="320"
               style="-fx-background-color: rgba(255,255,255,0.08);
                      -fx-text-fill: white;
                      -fx-prompt-text-fill: #888888;
                      -fx-font-size: 14px;
                      -fx-padding: 12px 16px;
                      -fx-border-color: #e2b96f;
                      -fx-border-width: 0 0 1 0;
                      -fx-background-radius: 6;"/>

    <!-- Password -->
    <PasswordField fx:id="passwordField" promptText="Mật khẩu"
                   maxWidth="320"
                   style="-fx-background-color: rgba(255,255,255,0.08);
                          -fx-text-fill: white;
                          -fx-prompt-text-fill: #888888;
                          -fx-font-size: 14px;
                          -fx-padding: 12px 16px;
                          -fx-border-color: #e2b96f;
                          -fx-border-width: 0 0 1 0;
                          -fx-background-radius: 6;"/>

    <!-- Confirm Password -->
    <PasswordField fx:id="confirmPasswordField" promptText="Xác nhận mật khẩu"
                   maxWidth="320"
                   style="-fx-background-color: rgba(255,255,255,0.08);
                          -fx-text-fill: white;
                          -fx-prompt-text-fill: #888888;
                          -fx-font-size: 14px;
                          -fx-padding: 12px 16px;
                          -fx-border-color: #e2b96f;
                          -fx-border-width: 0 0 1 0;
                          -fx-background-radius: 6;"/>

    <!-- Label lỗi -->
    <Label fx:id="errorLabel"
           style="-fx-text-fill: #ff6b6b; -fx-font-size: 12px;"/>

    <!-- Button đăng ký -->
    <Button fx:id="registerButton" text="ĐĂNG KÝ" onAction="#handleRegister"
            maxWidth="320"
            style="-fx-background-color: linear-gradient(to right, #e2b96f, #c9973d);
                   -fx-text-fill: #1a1a2e;
                   -fx-font-weight: bold;
                   -fx-font-size: 14px;
                   -fx-padding: 12px;
                   -fx-background-radius: 25;
                   -fx-cursor: hand;"/>

    <!-- Hyperlink -->
    <Hyperlink text="Đã có tài khoản? Đăng nhập ngay"
               onAction="#goToLogin"
               style="-fx-text-fill: #e2b96f; -fx-font-size: 12px;
                      -fx-border-color: transparent;"/>

</VBox>